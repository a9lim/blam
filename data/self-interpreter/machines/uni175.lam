-- 175-bit universal machine (non-strict):  U (<M> ++ N) = M N  for closed M.
-- Tromp's intL dbl wiring around the 165's parser.
(\x. x x) (\x. (\intL. \cont.
  (\next. \list.
    list (\bit0. bit0 (\unused \r. r next) cont) (list list list))
  (\bit1. intL (\exp. bit1
    (cont (\args \arg. exp (\zx \zy. zx arg (zy args))))
    (intL (\exp2. cont (\args. exp args (exp2 args)))))))
  (x x)) (\x. x x)
