-- 172-bit universal machine (non-strict):  U (<M> ++ N) = M N  for closed M.
-- Tromp's intL dbl wiring around the 162's parser.
(\x. x x) (\x. (\intL. \cont. \list.
  list (\a. a) (\u. list (\q. cont) (list list u))
    (\bit1. intL (\exp. bit1
      (cont (\args \arg. exp (\zx \zy. zx arg (zy args))))
      (intL (\exp2. cont (\args. exp args (exp2 args)))))))
  (x x)) (\x. x x)
