-- The 162 with NEXT's stream named instead of passed by eta: the baseline
-- for any design that reads the child's stream again.
(\x. x x) (\x. (\intL. \cont. \list.
  list (\a. a) (\u. list (\q. cont) (list list u))
    (\bit1 \t. intL (\exp. bit1
      (cont (\args \arg. exp (\zx \zy. zx arg (zy args))))
      (intL (\exp2. cont (\args. exp args (exp2 args))))) t))
  (x x))
