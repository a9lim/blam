-- D7: dispatch on the lambda/app bit before parsing the first child.
(\x. x x) (\x. (\intL. \cont. \list.
  list (\a. a) (\u. list (\q. cont) (list list u))
    (\bit1. intL (bit1
      (\exp. cont (\args \arg. exp (\zx \zy. zx arg (zy args))))
      (\exp. intL (\exp2. cont (\args. exp args (exp2 args)))))))
  (x x))
