theorem Blc.Lean146Final.class_bound_146 : ∀ {T R Q : Term},
  FreeUnder 1 T →
    BetaJoin T ((var 0).app T) → Reader R → occ 1 R = 1 → Next Q → 146 ≤ SelfintWireCost.wire (assemble T R Q) :=
fun {T R Q} hT hfix hr hj hq =>
  class_bound_146_of_coverage Lean146Accounting.minimumLambdaCoverage Lean146Enum.fiveRowExclusion hT hfix hr hj hq
