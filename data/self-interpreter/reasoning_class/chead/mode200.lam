-- c-headed: one body parametrized by a mode sig in {K,F}, the root calls it twice
(\x. x x) (\x. (\p. \c. \s. (\g. c (g (\a. \b. a)) (g (\a. \b. b)))
   (\sig. s (\a. a) (\u. s (\q. sig) (s s u))
     (\bit1. p (\exp. bit1
       (sig (\args \arg. exp (\zx \zy. zx arg (zy args))))
       (p (\exp2. sig (\args. exp args (exp2 args))))))))
  (x x))
