/-
An unbounded semantic exclusion for pre-stream handoffs. For any
application-only template M[x,J], with J=lambda x.x(lambda y.x), put
A=lambda x.x M[x,J]. Every finite application tree generated by A and J
that has a finite weak-head clock beta-reduces to A or J. The proof uses
strong induction on that clock, with syntax as the tie-break; beta steps
inside arguments cannot increase the clock. No evaluator fuel, source-size
cap, or normalization claim for a divergent computation is assumed.

Therefore every such generated source followed first by a rigid operand
fails the reader laws. In particular this excludes the unresolved pending
sources 4998--5000 in
 data/self-interpreter/reasoning_class/pending/X_REMAINING.tsv.
This does not classify all root lets or prove the 46-bit reader floor.
-/
import Blc.SelfintRootLetPowers
import Blc.WeakHeadClock
namespace Blc.SelfintRootLetOrbit
open Term SelfintClass SelfintLowerBound SelfintWireCost SelfintFloor
open SelfintSourceCost SelfintLocalCost SelfintDispatchAudit SelfintWidenHoist SelfintControl
open SelfintFlatMinimum SelfintRootFlat SelfintSourceFront SelfintNeededHead
open SelfintLambdaSink SelfintNestedLets WeakHeadClock
open SelfintRootLetPowers (J keep J_apply keep_apply J_idempotent reader_betas)
set_option maxRecDepth 10000
set_option maxHeartbeats 3000000

/-- Extract the weak-head clock of a function from its application. -/
theorem count_fn : ∀ n, ∀ {f a : Term}, Count (.app f a) n →
    ∃ m, m ≤ n ∧ Count f m := by
  intro n
  induction n using Nat.strongRecOn with
  | ind n ih =>
    intro f a hc
    cases f with
    | var v => exact ⟨0,by omega,.stop rfl⟩
    | lam b => exact ⟨0,by omega,.stop rfl⟩
    | app g b =>
      cases hc with
      | stop hs =>
        have hf : weakStep (.app g b)=none := by
          simp only [weakStep,Option.map_eq_none_iff] at hs
          exact hs
        exact ⟨0,by omega,.stop hf⟩
      | @step _ u k hs ht =>
        simp only [weakStep,Option.map_eq_some_iff] at hs
        obtain ⟨v,hv,rfl⟩ := hs
        obtain ⟨m,hm,hcm⟩ := ih k (by omega) ht
        exact ⟨m+1,by omega,.step hv hcm⟩

inductive Template where
  | x : Template
  | j : Template
  | app : Template → Template → Template

def Template.emit : Template → Term → Term
  | .x, a => a
  | .j, _ => J
  | .app f u, a => .app (f.emit a) (u.emit a)

def helper (t : Template) : Term := .lam (.app (.var 0) (t.emit (.var 0)))

theorem Template.subst (t : Template) (a : Term) :
    substDec 0 a (t.emit (.var 0))=t.emit a := by
  induction t with
  | x => rfl
  | j => exact SelfintRootLetPowers.J_subst 0 a
  | app f u ihf ihu => simp only [Template.emit,substDec] at *; rw [ihf,ihu]

theorem helper_apply (t : Template) (a : Term) :
    Beta (.app (helper t) a) (.app a (t.emit a)) := by
  simpa only [helper,contract,substDec,if_true,t.subst] using
    Beta.beta (.app (.var 0) (t.emit (.var 0))) a

theorem J_helper (t : Template) : Betas (.app J (helper t)) (helper t) :=
  .head (J_apply _) (.head (helper_apply _ _) (.head (keep_apply _ _) (.refl _)))

theorem Template.betas (t : Template) {a b : Term} (h : Betas a b) :
    Betas (t.emit a) (t.emit b) := by
  induction t with
  | x => exact h
  | j => exact .refl _
  | app f u ihf ihu => exact betas_app ihf ihu

inductive Orbit (t : Template) : Term → Prop where
  | helper : Orbit t (helper t)
  | j : Orbit t J
  | app {f a : Term} : Orbit t f → Orbit t a → Orbit t (.app f a)

theorem Template.emit_orbit (t q : Template) {a : Term} (ha : Orbit t a) :
    Orbit t (q.emit a) := by
  induction q with
  | x => exact ha
  | j => exact .j
  | app f u ihf ihu => exact .app ihf ihu

/-- If a generated pre-stream computation has a finite weak-head clock,
    it reduces to one of its two generators. Infinite computations are not
    mislabeled as finite failures. -/
theorem orbit_collapse (t : Template) : ∀ n, ∀ {a : Term}, Orbit t a → Count a n →
    Betas a (helper t) ∨ Betas a J := by
  intro n
  induction n using Nat.strongRecOn with
  | ind n ih =>
    intro a ha
    induction ha with
    | helper => intro _; exact .inl (.refl _)
    | j => intro _; exact .inr (.refl _)
    | @app f a hf ha ihf iha =>
      intro hc
      obtain ⟨m,hm,hcf⟩ := count_fn n hc
      have hfv : Betas f (helper t) ∨ Betas f J := by
        by_cases he : m=n
        · subst m; exact ihf hcf
        · exact ih m (by omega) hf hcf
      rcases hfv with hfh | hfj
      · have hprefix := betas_appL a hfh
        obtain ⟨q,hq,hcq⟩ := count_reduct n hc hprefix
        have hstep : weakStep (.app (helper t) a)=some (.app a (t.emit a)) := by
          simp only [helper,weakStep,contract,substDec,if_true,t.subst]
        obtain ⟨p,hp,hcp⟩ := head_decreases hcq hstep
        obtain ⟨r,hr,hcr⟩ := count_fn p hcp
        have hav := ih r (by omega) ha hcr
        rcases hav with hah | haj
        · have hs := betas_app hah (t.betas hah)
          obtain ⟨s,hsp,hcs⟩ := count_reduct p hcp hs
          have hend := ih s (by omega) (Orbit.app Orbit.helper (t.emit_orbit t Orbit.helper)) hcs
          have htotal := betas_trans hprefix (.head (helper_apply t a) hs)
          rcases hend with h | h
          · exact .inl (betas_trans htotal h)
          · exact .inr (betas_trans htotal h)
        · have hs := betas_app haj (t.betas haj)
          obtain ⟨s,hsp,hcs⟩ := count_reduct p hcp hs
          have hend := ih s (by omega) (Orbit.app Orbit.j (t.emit_orbit t Orbit.j)) hcs
          have htotal := betas_trans hprefix (.head (helper_apply t a) hs)
          rcases hend with h | h
          · exact .inl (betas_trans htotal h)
          · exact .inr (betas_trans htotal h)
      · have hprefix := betas_appL a hfj
        obtain ⟨q,hq,hcq⟩ := count_reduct n hc hprefix
        have hstep : weakStep (.app J a)=some (.app a (keep a)) := by
          simp only [J,keep,weakStep,contract,substDec,if_true]
        obtain ⟨p,hp,hcp⟩ := head_decreases hcq hstep
        obtain ⟨r,hr,hcr⟩ := count_fn p hcp
        have hav := ih r (by omega) ha hcr
        rcases hav with hah | haj
        · exact .inl (betas_trans hprefix (betas_trans (betas_appR J hah) (J_helper t)))
        · exact .inr (betas_trans hprefix (betas_trans (betas_appR J haj) J_idempotent))

theorem count_spine_fn (cs : List Term) : ∀ {a : Term} {n : Nat},
    Count (spine a cs) n → ∃ m, m ≤ n ∧ Count a m := by
  induction cs with
  | nil => intro a n hc; exact ⟨n,Nat.le_refl _,hc⟩
  | cons c cs ih =>
    intro a n hc
    obtain ⟨m,hm,hcm⟩ := ih hc
    obtain ⟨q,hq,hcq⟩ := count_fn m hcm
    exact ⟨q,by omega,hcq⟩

/-- No bound on the template, generated source tree, or pending operands.
    The premise on the first pending operand is literal rigidity only. -/
theorem orbit_not_reader_after_rigid (t : Template) {a : Term} (ha : Orbit t a)
    (v : Nat) (cs : List Term) : ¬ Reader (spine a (.var v::cs)) := by
  intro hr
  obtain ⟨n,hcn⟩ := hasNormalForm_count ⟨zeroOut,hr.zero_red,zeroOut_normal⟩
  obtain ⟨m,hm,hcm⟩ := count_fn n hcn
  obtain ⟨q,hq,hcq⟩ := count_spine_fn (.var v::cs) hcm
  rcases orbit_collapse t q ha hcq with hh | hj
  · have hr' := reader_betas hr (betas_spine hh (.var v::cs))
    have hb := SelfintSourceCost.spine_beta (helper_apply t (.var v)) cs
    exact reader_not_rigid (hr'.beta hb)
      (SelfintFlatPrefix.rigid_spine_of (.app _ (.var v)) cs)
  · exact SelfintRootLetPowers.value_not_reader_after_rigid .j v cs
      (reader_betas hr (betas_spine hj (.var v::cs)))

def diagonal (t : Template) : Term :=
  .app (.lam (.app (.var 0) (.var 0))) (helper t)

theorem diagonal_not_reader_after_rigid (t : Template) (v : Nat) (cs : List Term) :
    ¬ Reader (spine (diagonal t) (.var v::cs)) := by
  intro hr
  have hb := SelfintSourceCost.spine_beta
    (Beta.beta (.app (.var 0) (.var 0)) (helper t)) (.var v::cs)
  exact orbit_not_reader_after_rigid t (Orbit.app Orbit.helper Orbit.helper) v cs (hr.beta hb)

/-- M[x,J]=(x J) x. The corresponding A A does not receive a bounded
    normalization verdict here; the generic weak-head theorem excludes the
    reader stack whether its pre-stream computation terminates or not. -/
def pendingTemplate : Template := .app (.app .x .j) .x

def pending4998 : Term := spine (diagonal pendingTemplate) [.var 1,.var 0,.var 0]
def pending4999 : Term := spine (diagonal pendingTemplate) [.var 0,.var 1,.var 0]
def pending5000 : Term := spine (diagonal pendingTemplate) [.var 0,.var 0,.var 1]

theorem pending_weights :
    weight 0 pending4998=45 ∧ weight 0 pending4999=45 ∧ weight 0 pending5000=45 := by decide

theorem pending4998_not_reader : ¬ Reader pending4998 :=
  diagonal_not_reader_after_rigid pendingTemplate 1 [.var 0,.var 0]

theorem pending4999_not_reader : ¬ Reader pending4999 :=
  diagonal_not_reader_after_rigid pendingTemplate 0 [.var 1,.var 0]

theorem pending5000_not_reader : ¬ Reader pending5000 :=
  diagonal_not_reader_after_rigid pendingTemplate 0 [.var 0,.var 1]

#print axioms orbit_collapse
#print axioms orbit_not_reader_after_rigid
end Blc.SelfintRootLetOrbit
