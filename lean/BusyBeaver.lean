def wrap : Nat → Term → Term
  | 0, t => t
  | n + 1, t => .lam (wrap n t)

theorem wrap_noNormalForm {t : Term} (h : ¬ HasNormalForm t) :
    ∀ n, ¬ HasNormalForm (wrap n t)
  | 0 => h
  | n + 1 => by
      rintro ⟨nf, hred, hnf⟩
      exact wrap_noNormalForm h n (lam_betas_nf hred hnf rfl)

